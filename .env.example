# Servidor
PORT=8080
PUBLIC_BASE_URL=https://contexto-bridge.duckdns.org

# Redis
REDIS_URL=redis://host.docker.internal:6379

# Retencion de contexto (debe cubrir espera maxima de cola)
CONTEXT_TTL_SECONDS=900

# Historial de interacciones previas mostrado en el panel del agente.
# Independiente del contexto en curso: sobrevive al TTL de arriba.
# 7776000 = 90 dias. El TTL se renueva en cada llamada del paciente.
HISTORY_TTL_SECONDS=7776000
# Cantidad de interacciones PREVIAS visibles por numero.
HISTORY_MAX_ITEMS=10

# Auth: ElevenLabs -> POST /api/context
INGEST_API_KEY=change-me

# Auth: Yeastar CRM template -> /crm/*
CRM_API_KEY=change-me

# Tokens del panel
PANEL_TOKEN_SECRET=change-me-generate-a-32-byte-secret
PANEL_TOKEN_TTL_SECONDS=1800

# Logging
LOG_LEVEL=info
